APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PROJECT_PORT=80

#Linux/MacOS 1000/501
UID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db_test
DB_USERNAME=test
DB_PASSWORD=test

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=users.notifications.verify
RABBITMQ_EXCHANGE_NAME=users.direct
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_EXCHANGE_DECLARE=true
RABBITMQ_EXCHANGE_DURABLE=true
RABBITMQ_QUEUE_DECLARE=true
RABBITMQ_QUEUE_BIND=true
RABBITMQ_QUEUE_DURABLE=true
RABBITMQ_WORKER=default
RABBITMQ_MANAGEMENT_PORT=15672

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

### Почтовый сервис mail.ru
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ru
MAIL_PORT=587
MAIL_USERNAME=your@mail.ru
MAIL_PASSWORD=app_password
MAIL_FROM_ADDRESS=your@mail.ru
MAIL_FROM_NAME="Laravel Shop"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
